{
  "name": "@intelligent-ui/framework",
  "version": "0.1.0",
  "description": "Standalone OpenUI Lang component framework and controlled host adapter",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "import": "./dist/prompt/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "build": "node scripts/build.mjs",
    "demo": "vite --config examples/vite-react-demo/vite.config.ts",
    "demo:build": "vite build --config examples/vite-react-demo/vite.config.ts",
    "verify:consumers": "node scripts/verify-consumers.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@openuidev/lang-core": "1.0.0",
    "@openuidev/react-lang": "1.0.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.562.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "playwright-core": "^1.64.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
