{
  "name": "@intelligent-ui/framework",
  "version": "0.2.0",
  "description": "Standalone OpenUI Lang component framework and controlled host adapter",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "import": "./dist/prompt/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./gallery": {
      "types": "./dist/gallery/index.d.ts",
      "import": "./dist/gallery/index.js"
    },
    "./benchmark": {
      "types": "./dist/benchmark/index.d.ts",
      "import": "./dist/benchmark/index.js"
    },
    "./plugins/map": {
      "types": "./dist/plugins/map/index.d.ts",
      "import": "./dist/plugins/map/index.js"
    },
    "./plugins/html": {
      "types": "./dist/plugins/html/index.d.ts",
      "import": "./dist/plugins/html/index.js"
    },
    "./plugins/upstream": {
      "types": "./dist/plugins/upstream.d.ts",
      "import": "./dist/plugins/upstream.js"
    },
    "./map-worker": {
      "types": "./dist/map-worker.d.ts",
      "import": "./dist/map-worker.js"
    },
    "./plugins/map/styles.css": "./dist/plugins/map/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "build": "node scripts/build.mjs",
    "demo": "vite --config examples/vite-react-demo/vite.config.ts",
    "demo:build": "vite build --config examples/vite-react-demo/vite.config.ts",
    "verify:consumers": "node scripts/verify-consumers.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "prepack": "npm run build",
    "bench": "node tools/bench/run.mjs",
    "bench:fixtures": "node tools/bench/run.mjs --fixtures",
    "verify:upstream-browser": "node scripts/verify-upstream-browser.mjs",
    "docs:generate": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:dev": "node scripts/prepare-docs-site.mjs && vitepress dev docs --host 127.0.0.1",
    "docs:build": "node scripts/prepare-docs-site.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1"
  },
  "dependencies": {
    "@openuidev/lang-core": "1.0.0",
    "@openuidev/react-lang": "1.0.0",
    "@types/geojson": "^7946.0.16",
    "katex": "0.18.2",
    "lucide-react": "^0.562.0"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "maplibre-gl": "^6.13.0",
    "playwright-core": "^1.64.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitepress": "1.6.4",
    "vitest": "^4.1.11",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lichman0405/intelligent-ui-framework.git"
  },
  "homepage": "https://lichman0405.github.io/intelligent-ui-framework/",
  "bugs": {
    "url": "https://github.com/lichman0405/intelligent-ui-framework/issues"
  }
}
